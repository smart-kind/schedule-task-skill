{"nodes": [{"id": "references_architecture_architecture", "label": "Architecture reference (canonical design rationale)", "file_type": "document", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_two_layer", "label": "Two-layer architecture (trigger / driver / executor)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggering is instantaneous while execution is multi-hour; separating them into layers with different owners lets the fragile long-running, limit-prone part be hardened while the trigger stays deterministic and trivial."}, {"id": "references_architecture_watchdog", "label": "Watchdog (worker daemon, 300s dispatch tick)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_dispatch", "label": "Dispatch tick (eligibility, concurrency cap, pid lock)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_runner", "label": "Runner (worktree, park-resume, trust-but-verify)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_executor", "label": "Executor (coding-agent CLI, the only component with a brain)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_agents_router", "label": "agents.js router (invoke contract, profiles)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runner never calls a CLI directly; it delegates to agents.js so adding a new executor CLI means adding one profile and nothing else changes."}, {"id": "references_architecture_profile", "label": "Agent profiles (claude | kimi)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_exit_code_contract", "label": "Exit-code contract (0 done / 75 limit / else ambiguous)", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_no_ai", "label": "Invariant: no AI in the control loop", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_add_only", "label": "Invariant: add-only design -> conflict-free merges", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each side only ever adds new files (author: tasks/prompts/batches; worker: reports on per-task branches). A shared mutable file would be a guaranteed merge conflict, so mutable runtime status lives off-git in gitignored state/."}, {"id": "references_architecture_invariant_gates_prose", "label": "Invariant: gates are prose, never fields", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_session_resume", "label": "Invariant: resume via CLI session ids", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a usage-limit hit the runner parks until the reset time then resumes the SAME CLI session with full context; session ids are persisted the moment they appear and recovered from the newest attempt log if the runner died first."}, {"id": "references_architecture_invariant_worktree_isolation", "label": "Invariant: per-task worktree isolation", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_task_branches", "label": "Invariant: per-task branches, never main/dev directly", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_machine_identity", "label": "Invariant: machine identity, no cross-machine racing", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every machine declares role+id in gitignored state/.machine at init; only role=worker dispatches and a task runs only on its named worker. Because state/ never crosses git this declaration is the only cross-machine coordination \u2014 enough because each task has exactly one owner."}, {"id": "references_architecture_invariant_author_merger", "label": "Invariant: the author is the only merger", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_invariant_liveness_pid", "label": "Invariant: liveness by PID, not by silence", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task is dead only when its process group is gone; an executor fanning out sub-agents can legitimately emit nothing for 10+ minutes, so never kill on stream silence \u2014 cancel kills the recorded process group (SIGTERM then SIGKILL after 5s)."}, {"id": "references_architecture_process_model", "label": "Process model (detached process groups replace tmux/flock)", "file_type": "rationale", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_architecture_sentinel", "label": "TASK_DONE sentinel + trust-but-verify completion", "file_type": "concept", "source_file": "references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Completion requires BOTH the [[TASK_DONE ...]] sentinel AND a new commit \u2014 the executor never self-certifies."}], "edges": [{"source": "references_architecture_architecture", "target": "docs_business_flow_business_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/architecture.md", "source_location": null, "weight": 1.0}, {"source": "references_architecture_two_layer", "target": "references_architecture_watchdog", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/architecture.md", "source_location": null, "weight": 1.0}, {"source": "references_architecture_two_layer", "target": "references_architecture_runner", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "s