{"nodes": [{"id": "docs_diagrams_cancel_flow_start", "label": "\u53d6\u6d88\u4efb\u52a1\uff08cancel\uff09", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_diagrams_cancel_flow_select_target", "label": "\u9009\u62e9\u76ee\u6807", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancel target is either a single task or all queued/running tasks at once."}, {"id": "docs_diagrams_cancel_flow_finished_decision", "label": "\u4efb\u52a1\u5df2\u7ecf\u6536\u5c3e\u4e86\uff1f", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision gate: a task already in a terminal state (completed/failed/cancelled) must not be touched."}, {"id": "docs_diagrams_cancel_flow_reject", "label": "\u62d2\u7edd\uff0c\u4e0d\u52a8\u5b83", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotency guard: cancellation of a finished task is a no-op, not an error."}, {"id": "docs_diagrams_cancel_flow_stop_running", "label": "\u505c\u6389\u8fd0\u884c\u4e2d\u7684\u4efb\u52a1", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops the task together with its coding assistant process; must work even while the task is waiting on a quota/limit."}, {"id": "docs_diagrams_cancel_flow_mark_cancelled", "label": "\u6807\u8bb0\u300c\u5df2\u53d6\u6d88\u300d+ \u8bb0\u5f55\u539f\u56e0", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After cancelling, the task is marked cancelled with a recorded reason; the watchdog skips it from then on and notification hooks receive the cancel message."}, {"id": "docs_diagrams_cancel_flow_dependents_decision", "label": "\u6709\u4efb\u52a1\u4f9d\u8d56\u5b83\u5417\uff1f", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision gate: dependency graph traversal to decide whether downstream tasks are affected."}, {"id": "docs_diagrams_cancel_flow_cascade_cancel", "label": "\u7ea7\u8054\u53d6\u6d88\u4f9d\u8d56\u8005", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependents of a cancelled task cannot do useful work, so they are cancelled too, recording the root cause of the cancellation."}, {"id": "docs_diagrams_cancel_flow_preserve_workspace", "label": "\u6536\u5c3e\uff1a\u4ee3\u7801\u73b0\u573a\u4fdd\u7559", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The task branch and working state are left untouched so the workspace can be inspected afterwards."}, {"id": "docs_diagrams_cancel_flow_done", "label": "\u5b8c\u6210", "file_type": "image", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_diagrams_cancel_flow_watchdog", "label": "\u770b\u95e8\u72d7\uff08watchdog\uff09", "file_type": "concept", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime supervisor that picks up tasks; after cancellation it permanently skips the cancelled task."}, {"id": "docs_diagrams_cancel_flow_notification_hooks", "label": "\u901a\u77e5\u94a9\u5b50", "file_type": "concept", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook mechanism that receives a cancel message so external systems are notified of the cancellation."}, {"id": "docs_diagrams_cancel_flow_coding_assistant", "label": "\u7f16\u7801\u52a9\u624b", "file_type": "concept", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The autonomous coding-agent process attached to a running task; cancelling a task also stops this process, even when it is waiting on a quota."}, {"id": "docs_diagrams_cancel_flow_executor_only", "label": "\u53d6\u6d88\u53ea\u5728\u6267\u884c\u673a\u4e0a\u751f\u6548", "file_type": "rationale", "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation only takes effect on the executor machine that owns the task, because it requires live workspace state and the running process."}], "edges": [{"source": "docs_diagrams_cancel_flow_start", "target": "docs_diagrams_cancel_flow_select_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "weight": 1.0}, {"source": "docs_diagrams_cancel_flow_select_target", "target": "docs_diagrams_cancel_flow_finished_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/diagrams/cancel-flow.svg", "source_location": null, "weight": 1.0}, {"source": "docs_diagra